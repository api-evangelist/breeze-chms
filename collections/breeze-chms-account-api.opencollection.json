{
  "opencollection": "1.0.0",
  "info": {
    "name": "Breeze ChMS Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Key",
      "value": "{{Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve account summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/account/summary"
          },
          "docs": "Retrieve account summary"
        },
        {
          "info": {
            "name": "List account activity log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/account/list_log",
            "params": [
              {
                "name": "action",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "details",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List account activity log"
        }
      ]
    }
  ],
  "bundled": true
}