{
  "opencollection": "1.0.0",
  "info": {
    "name": "Breeze ChMS Account Tags API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Key",
      "value": "{{Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/list_tags",
            "params": [
              {
                "name": "folder_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List tags"
        },
        {
          "info": {
            "name": "List tag folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/list_folders"
          },
          "docs": "List tag folders"
        },
        {
          "info": {
            "name": "Add a tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/add_tag",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "folder_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Add a tag"
        },
        {
          "info": {
            "name": "Add a tag folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/add_tag_folder",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "parent_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Add a tag folder"
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/delete_tag",
            "params": [
              {
                "name": "tag_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Delete a tag"
        },
        {
          "info": {
            "name": "Delete a tag folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/delete_tag_folder",
            "params": [
              {
                "name": "folder_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Delete a tag folder"
        },
        {
          "info": {
            "name": "Assign a tag to a person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/assign",
            "params": [
              {
                "name": "person_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Assign a tag to a person"
        },
        {
          "info": {
            "name": "Unassign a tag from a person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.breezechms.com/api/tags/unassign",
            "params": [
              {
                "name": "person_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Unassign a tag from a person"
        }
      ]
    }
  ],
  "bundled": true
}